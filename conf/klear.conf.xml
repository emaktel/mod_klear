<configuration name="klear.conf" description="mod_klear: AEC3 + DeepFilterNet">
  <settings>
    <!-- default-preset:
           agent      (default)  DF-only neural denoise. Best for AI agents /
                                 ASR feeds / any scenario where near-end
                                 speech preservation matters more than
                                 the last few dB of echo removal.
                                 Doubletalk AECMOS: echo 3.47 / deg 3.26.
           telephony              AEC3 + DF aggressive. Maximum echo removal
                                 (>38 dB far-end ERLE). Costs ~1.3 MOS of
                                 near-end degradation during doubletalk.
                                 Best for classic human-to-human calling.
           aec_only               Raw WebRTC AEC3, no neural NS. Cheapest
                                 path (~0.02 RTF); ~17 dB ERLE. -->
    <param name="default-preset" value="agent"/>

    <!-- DeepFilterNet attenuation limit in dB. 30 dB with post-filter off
         is the measurement-tuned setting from test/reports/df_sweep.md.
         Raise for more aggressive denoising, lower for maximum speech
         preservation. -->
    <param name="default-ns-atten-db" value="30.0"/>

    <!-- Enable AEC3's high-pass filter in any preset that runs AEC. Mostly
         harmless but can drop a few dB of low-frequency rumble. -->
    <param name="default-hpf" value="true"/>
  </settings>
</configuration>
